# Local development database
POSTGRES_PASSWORD=replace-with-a-development-only-password

# Raspberry Pi production deployment (.env.production)
TFHUB_HTTP_PORT=8081
TFHUB_DB_NAME=tfhub
TFHUB_DB_ADMIN_USER=postgres
TFHUB_DB_ADMIN_PASSWORD=replace-with-a-unique-random-secret
TFHUB_DB_USER=tfhub_app
TFHUB_DB_PASSWORD=replace-with-a-different-unique-random-secret
TFHUB_BACKUP_RCLONE_CONFIG_DIR=/home/pi/.config/tfhub-rclone
TFHUB_BACKUP_RCLONE_REMOTE=tfhub-crypt
TFHUB_BACKUP_RCLONE_PATH=.
TFHUB_BACKUP_COMMAND_TIMEOUT_SECONDS=600
